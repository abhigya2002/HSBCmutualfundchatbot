{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "pip install -r requirements.txt -r phases/phase-6-api-ui/requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd phases/phase-6-api-ui && python -m phase_6_2.run_server --host 0.0.0.0 --port $PORT"
  }
}
